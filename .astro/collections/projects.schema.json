{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "coverImage": {
          "type": "string"
        },
        "heroAltText": {
          "type": "string"
        },
        "heroLocation": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ]
        },
        "asciiDarken": {
          "type": "number"
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "process": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "default",
                  "branch",
                  "merge"
                ]
              },
              "branchFrom": {
                "type": "string"
              },
              "mergesInto": {
                "type": "string"
              },
              "style": {
                "type": "object",
                "properties": {
                  "loop": {
                    "type": "boolean"
                  },
                  "pause": {
                    "type": "boolean"
                  },
                  "dashed": {
                    "type": "boolean"
                  },
                  "intensity": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "label",
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
