---
import GridLayout from "./Grid/GridLayout.astro";
import WidthLayout from "./Grid/WidthLayout.astro";

export interface MDXContent {
    slug: string;
    frontMatter: {
        title: string;
        date: string;
    };
    content: string;
}

interface PostsByYear {
    [year: string]: MDXContent[];
}

interface Props {
    posts: MDXContent[];
    postsByYear: PostsByYear;
}

const { posts, postsByYear } = Astro.props;

const sortedYears = Object.keys(postsByYear).sort(
    (a, b) => parseInt(b) - parseInt(a),
);

// Parse European date format (DD.MM.YYYY)
const parseEuropeanDate = (dateStr: string) => {
    const [day, month, year] = dateStr.split(".");
    return new Date(`${year}-${month}-${day}`);
};

const formatDate = (dateStr: string) => {
    const postDate = parseEuropeanDate(dateStr);
    return postDate.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
};
---

<WidthLayout>
    <div class="mt-18">
        {posts.length > 0 ? (
            <>
                {sortedYears.map((year) => (
                    <div key={year} class="mb-12">
                        <GridLayout>
                            <div class="md:col-span-9">
                                <div class="grid grid-cols-9">
                                    <h2 class="font-fancy mb-6 text-left text-4xl font-extrabold tracking-tight text-gray-900 sm:col-span-2 sm:col-start-1 sm:text-right sm:text-3xl">
                                        {year}
                                    </h2>
                                </div>
                            </div>
                            <div class="md:col-span-9">
                                {postsByYear[year].map((post) => (
                                    <div key={post.slug} class="mb-3">
                                        <div class="grid grid-cols-9 items-baseline gap-0">
                                            <span class="font-fancy col-span-2 col-start-1 text-left text-sm font-semibold text-gray-500 sm:col-span-2 sm:col-start-1 sm:text-right">
                                                {formatDate(post.frontMatter.date)}
                                            </span>
                                            <h3 class="col-span-7 col-start-3 text-lg text-gray-500 transition-colors hover:text-red-500 sm:col-span-6 sm:col-start-3 sm:pl-6 md:col-span-6 md:col-start-3">
                                                <a
                                                    href={`/blog/${post.slug}`}
                                                    class="block"
                                                >
                                                    {post.frontMatter.title}
                                                </a>
                                            </h3>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </GridLayout>
                    </div>
                ))}
            </>
        ) : (
            <div class="rounded-lg bg-gray-50 py-12 text-center md:col-span-5">
                <h3 class="mb-2 text-2xl font-semibold">
                    No blog posts yet
                </h3>
                <p class="text-gray-600">
                    Check back soon for new content!
                </p>
            </div>
        )}
    </div>
</WidthLayout>