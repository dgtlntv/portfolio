---
import AnimatedImage from "../Image/AnimatedImage.astro"

interface Props {
    src: string
    alt: string
    [key: string]: any
}

const { src, alt, ...props } = Astro.props
---

<div class="relative mx-auto md:-mx-4 lg:-mx-6 xl:-mx-12 my-8">
    <AnimatedImage src={src} alt={alt} rotationDirection="right" {...props} />
</div>
