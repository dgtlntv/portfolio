---
interface Props {
    src?: string
    alt?: string
    [key: string]: any
}

const { src, alt, ...props } = Astro.props
---

<div
    class="relative mx-auto md:-mx-6 lg:-mx-8 xl:-mx-28 my-8 transition duration-700 ease-in-out hover:-translate-y-0.5 hover:rotate-[0.2deg] hover:transform-gpu"
>
    <img
        class="w-full h-auto rounded-lg transition duration-700 ease-in-out hover:scale-[1.01]"
        src={src}
        alt={alt}
        {...props}
    />
</div>
