---
import GridLayout from "../../Grid/GridLayout.astro"
import WidthLayout from "../../Grid/WidthLayout.astro"
import ProjectsListItem from "./ProjectsListItem.astro"
import type { CollectionEntry } from "astro:content"

interface Props {
    projects: CollectionEntry<"projects">[]
}

const { projects } = Astro.props
---

<div class="overflow-hidden pt-0 pb-16">
    <WidthLayout>
        <GridLayout>
            {
                projects.map((project, index) => (
                    <ProjectsListItem
                        title={project.data.title}
                        url={project.slug}
                        imageUrl={
                            project.data.coverImage
                                ? project.data.coverImage
                                : ""
                        }
                        heroLocation={project.data.heroLocation}
                        asciiDarken={project.data.asciiDarken}
                        isLeft={index % 2 === 0}
                    >
                        {project.data.excerpt}
                    </ProjectsListItem>
                ))
            }
        </GridLayout>
    </WidthLayout>
</div>
