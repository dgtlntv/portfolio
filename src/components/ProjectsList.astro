---
import GridLayout from "./Grid/GridLayout.astro";
import WidthLayout from "./Grid/WidthLayout.astro";
import ProjectItem from "./ProjectItem/ProjectItem.astro";

export interface MDXContent {
    slug: string;
    frontMatter: {
        title: string;
        coverImage?: string;
        heroLocation?: 'cover' | 'contain';
        asciiDarken?: number;
        excerpt: string;
    };
    content: string;
}

interface Props {
    projects: MDXContent[];
}

const { projects } = Astro.props;
---

<div class="overflow-hidden pt-0 pb-16">
    <WidthLayout>
        <GridLayout>
            {projects.map((project, index) => (
                <ProjectItem
                    key={project.slug}
                    title={project.frontMatter.title}
                    url={project.slug}
                    imageUrl={
                        project.frontMatter.coverImage
                            ? project.frontMatter.coverImage
                            : ""
                    }
                    heroLocation={project.frontMatter.heroLocation}
                    asciiDarken={project.frontMatter.asciiDarken}
                    isLeft={index % 2 === 0}
                >
                    {project.frontMatter.excerpt}
                </ProjectItem>
            ))}
        </GridLayout>
    </WidthLayout>
</div>