---
interface Props {
    title: string
    formattedDate: string
    slug: string
}

const { title, formattedDate, slug } = Astro.props
---

<div class="mb-3">
    <div class="grid grid-cols-9 items-baseline gap-0">
        <span
            class="font-fancy col-span-2 col-start-1 text-left text-sm font-semibold text-gray-500 sm:col-span-2 sm:col-start-1 sm:text-right"
        >
            {formattedDate}
        </span>
        <h3
            class="col-span-7 col-start-3 text-lg text-gray-500 transition-colors hover:text-red-500 sm:col-span-6 sm:col-start-3 sm:pl-6 md:col-span-6 md:col-start-3"
        >
            <a href={`/blog/${slug}`} class="block">
                {title}
            </a>
        </h3>
    </div>
</div>
