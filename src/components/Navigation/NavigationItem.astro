---
export interface Props {
    to: string
    label: string
    isExternal: boolean
    variant: "mobile" | "desktop"
}

const { to, label, isExternal, variant } = Astro.props

const className =
    variant === "mobile"
        ? "font-fancy text-base font-medium text-gray-900 hover:text-gray-700"
        : "font-fancy text-base font-medium text-gray-500 hover:text-gray-900 hover:underline hover:decoration-dashed hover:decoration-1 hover:underline-offset-8"

const linkProps = isExternal
    ? { target: "_blank", rel: "noopener noreferrer" }
    : {}

const dataAttributes = variant === "mobile" ? { "data-popover": "close" } : {}
---

<a href={to} class={className} {...linkProps} {...dataAttributes}>
    {label}
</a>
