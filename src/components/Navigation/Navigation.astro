---
import Bars3 from "astro-heroicons/outline/Bars3.astro"
import XMark from "astro-heroicons/outline/XMark.astro"
import ContactButton from "./ContactButton.astro"
import Logo from "./Logo.astro"
import NavigationItem from "./NavigationItem.astro"
const BASE_URL = import.meta.env.BASE_URL || "/"
const NAVIGATION_LINKS = [
    { to: "/projects", label: "Projects", isExternal: false },
    { to: "/blog", label: "Blog", isExternal: false },
    {
        to: `${BASE_URL}onepager.pdf`.replace("//", "/"),
        label: "Onepager",
        isExternal: true,
    },
]
---

<nav class="relative z-50 bg-white">
    <div
        class="flex items-center justify-between px-4 py-6 sm:px-6 md:justify-start"
    >
        <div class="flex justify-start lg:w-0 lg:flex-1">
            <Logo />
        </div>
        <!-- Mobile menu button -->
        <div class="-my-2 -mr-2 md:hidden">
            <button
                id="mobile-menu-trigger"
                class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:ring-2 focus:ring-black focus:outline-none focus:ring-inset"
            >
                <span class="sr-only">Open menu</span>
                <Bars3 class="h-6 w-6" />
            </button>
        </div>
        <!-- Desktop navigation -->
        <div class="hidden items-center justify-end md:flex md:flex-1 lg:w-0">
            <div class="flex items-center gap-8">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <NavigationItem
                            to={link.to}
                            label={link.label}
                            isExternal={link.isExternal}
                            variant="desktop"
                        />
                    ))
                }
                <ContactButton />
            </div>
        </div>
    </div>
    <!-- Mobile dialog menu -->
    <mobile-menu-dialog id="mobile-menu-dialog" class="md:hidden">
        <div class="px-4 py-5 sm:px-6">
            <div class="flex items-center justify-between">
                <Logo />
                <div>
                    <button
                        id="mobile-menu-close"
                        class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:ring-2 focus:ring-black focus:outline-none focus:ring-inset"
                    >
                        <span class="sr-only">Close menu</span>
                        <XMark class="h-6 w-6" />
                    </button>
                </div>
            </div>
        </div>
        <div class="px-4 py-6 sm:px-6">
            <div class="grid grid-cols-1 gap-4">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <NavigationItem
                            to={link.to}
                            label={link.label}
                            isExternal={link.isExternal}
                            variant="mobile"
                        />
                    ))
                }
                <ContactButton />
            </div>
        </div>
    </mobile-menu-dialog>
</nav>
<script>
    import { LitElement, html, css } from "lit"
    import { globalStyleSheet } from "../../styles/styleSheet.js"

    class MobileMenuDialog extends LitElement {
        static styles = [
            globalStyleSheet,
            css`
                @keyframes slideDown {
                    from {
                        opacity: 0;
                        transform: translateY(-10px);
                    }
                    to {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }
                @keyframes slideUp {
                    from {
                        opacity: 1;
                        transform: translateY(0);
                    }
                    to {
                        opacity: 0;
                        transform: translateY(-10px);
                    }
                }
                .slide-down {
                    animation: slideDown 0.2s ease-out;
                }
                .slide-up {
                    animation: slideUp 0.2s ease-out;
                }
            `,
        ]

        private _dialog: HTMLDialogElement | null = null

        firstUpdated(): void {
            // Cache the dialog reference
            this._dialog = this.shadowRoot?.querySelector("dialog") ?? null

            // Set up close button event listener
            const closeButton = this.querySelector("#mobile-menu-close")
            closeButton?.addEventListener("click", this.handleCloseButtonClick)

            // Close menu after navigation item is clicked
            this.addEventListener("click", this.handleNavigationClick)
        }

        disconnectedCallback(): void {
            super.disconnectedCallback()
            const closeButton = this.querySelector("#mobile-menu-close")
            if (closeButton) {
                closeButton.removeEventListener(
                    "click",
                    this.handleCloseButtonClick,
                )
            }
            this.removeEventListener("click", this.handleNavigationClick)

            if (this._dialog) {
                this._dialog.removeEventListener(
                    "click",
                    this.handleBackdropClick,
                )
            }
        }

        private handleCloseButtonClick = (): void => {
            this.close()
        }

        private handleBackdropClick = (e: MouseEvent): void => {
            if (e.target === this._dialog) {
                this.close()
            }
        }

        private handleNavigationClick = (e: Event): void => {
            const target = e.target as HTMLElement
            if (target.closest("a[href]") && this._dialog?.open) {
                setTimeout(() => this.close(), 150)
            }
        }

        private stopPropagation = (e: Event): void => {
            e.stopPropagation()
        }

        render() {
            return html`
                <dialog
                    class="fixed top-2 right-2 left-2 m-0 w-auto max-w-none rounded-md border border-black bg-white p-0 shadow-lg"
                    @click=${this.handleBackdropClick}
                >
                    <div
                        class="border-t-2 border-b-2 border-gray-100"
                        @click=${this.stopPropagation}
                    >
                        <slot></slot>
                    </div>
                </dialog>
            `
        }

        open(): void {
            if (this._dialog) {
                this._dialog.showModal()
                this._dialog.classList.add("slide-down")
            }
        }

        close(): void {
            if (this._dialog) {
                this._dialog.classList.remove("slide-down")
                this._dialog.classList.add("slide-up")

                // Wait for animation to complete before closing
                setTimeout(() => {
                    this._dialog?.close()
                    this._dialog?.classList.remove("slide-up")
                }, 200) // Match animation duration
            }
        }
    }

    customElements.define("mobile-menu-dialog", MobileMenuDialog)

    interface MobileMenuDialogElement extends HTMLElement {
        open(): void
        close(): void
    }

    const menuTrigger = document.getElementById("mobile-menu-trigger")
    const menuDialog = document.getElementById(
        "mobile-menu-dialog",
    ) as MobileMenuDialogElement | null

    menuTrigger?.addEventListener("click", () => {
        menuDialog?.open()
    })
</script>
