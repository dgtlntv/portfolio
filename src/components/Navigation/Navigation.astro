---
import Bars3 from "astro-heroicons/outline/Bars3.astro"
import XMark from "astro-heroicons/outline/XMark.astro"
import ContactButton from "./ContactButton.astro"
import Logo from "./Logo.astro"
import NavigationItem from "./NavigationItem.astro"

const BASE_URL = import.meta.env.BASE_URL || "/"

const NAVIGATION_LINKS = [
    { to: "/projects", label: "Projects", isExternal: false },
    { to: "/blog", label: "Blog", isExternal: false },
    {
        to: `${BASE_URL}onepager.pdf`.replace("//", "/"),
        label: "Onepager",
        isExternal: true,
    },
]
---

<!-- need to fix the part styling with tailwind plugin does not work -->
<nav class="font-fancy relative z-50 bg-white">
    <div
        class="flex items-center justify-between px-4 py-6 sm:px-6 md:justify-start"
    >
        <div class="flex justify-start lg:w-0 lg:flex-1">
            <Logo />
        </div>

        <!-- Mobile menu button -->
        <div class="-my-2 -mr-2 md:hidden">
            <button
                id="mobile-menu-trigger"
                class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:ring-2 focus:ring-black focus:outline-none focus:ring-inset"
            >
                <span class="sr-only">Open menu</span>
                <Bars3 class="h-6 w-6" />
            </button>
        </div>

        <!-- Desktop navigation -->
        <div class="hidden items-center justify-end md:flex md:flex-1 lg:w-0">
            <div class="flex items-center gap-8">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <NavigationItem
                            to={link.to}
                            label={link.label}
                            isExternal={link.isExternal}
                            variant="desktop"
                        />
                    ))
                }
                <ContactButton />
            </div>
        </div>
    </div>

    <!-- Mobile popup menu -->
    <wa-popup
        id="mobile-menu-popup"
        anchor="mobile-menu-trigger"
        placement="bottom"
        class="md:hidden"
    >
        <div
            class="fixed inset-x-2 top-2 divide-y-2 divide-gray-50 bg-white ring-1 shadow-lg ring-black ring-opacity-5 w-auto max-w-none rounded-md"
        >
            <div class="px-4 py-5 sm:px-6">
                <div class="flex items-center justify-between">
                    <Logo />
                    <div class="-mr-2">
                        <button
                            id="mobile-menu-close"
                            class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:ring-2 focus:ring-black focus:outline-none focus:ring-inset"
                        >
                            <span class="sr-only">Close menu</span>
                            <XMark class="h-6 w-6" />
                        </button>
                    </div>
                </div>
            </div>
            <div class="px-4 py-6 sm:px-6">
                <div class="grid grid-cols-1 gap-4">
                    {
                        NAVIGATION_LINKS.map((link) => (
                            <NavigationItem
                                to={link.to}
                                label={link.label}
                                isExternal={link.isExternal}
                                variant="mobile"
                            />
                        ))
                    }
                    <ContactButton />
                </div>
            </div>
        </div>
    </wa-popup>
</nav>

<script>
    import "@awesome.me/webawesome/dist/components/popup/popup.js"

    const menuTrigger = document.getElementById("mobile-menu-trigger")
    const menuPopup = document.getElementById("mobile-menu-popup")
    const menuClose = document.getElementById("mobile-menu-close")

    // Open popup
    menuTrigger?.addEventListener("click", () => {
        menuPopup.active = true
    })

    // Close popup
    menuClose?.addEventListener("click", () => {
        menuPopup.active = false
    })

    // Close popup when clicking outside
    document.addEventListener("click", (e) => {
        if (!menuPopup.contains(e.target) && !menuTrigger.contains(e.target)) {
            menuPopup.active = false
        }
    })
</script>
