---
/**
 * A reusable Lottie animation component
 */
export interface Props {
    /** Path to the Lottie JSON animation file */
    src: string
    /** Whether the animation should start automatically */
    autoplay?: boolean
    /** Whether the animation should loop */
    loop?: boolean
    /** Playback speed multiplier (e.g., 1.5 for 150% speed) */
    speed?: number
    /** Additional CSS classes to apply */
    class?: string
}

const {
    src,
    autoplay = true,
    loop = true,
    speed = 1,
    class: className = "",
} = Astro.props
---

<dotlottie-wc
    src={src}
    autoplay={autoplay}
    loop={loop}
    speed={speed.toString()}
    class={className}></dotlottie-wc>

<script>
    import "@lottiefiles/dotlottie-wc"
</script>
