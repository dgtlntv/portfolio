---
export interface Props {
    className?: string
}

const { className = "" } = Astro.props

interface Phase {
    readonly name: string
    readonly description: string
    readonly level: "document" | "section"
}

const phases: readonly Phase[] = [
    {
        name: "Discovery",
        description: "Understand what's being documented",
        level: "document",
    },
    {
        name: "Structure",
        description: "Define sections and order",
        level: "document",
    },
    {
        name: "Vomit draft",
        description: "Writer dumps raw content",
        level: "section",
    },
    {
        name: "Revision",
        description: "AI rewrites to brand voice",
        level: "section",
    },
    {
        name: "Review",
        description: "4 agents evaluate in parallel",
        level: "section",
    },
    {
        name: "Polish",
        description: "Address findings, finalise",
        level: "section",
    },
]

const reviewAgents: readonly string[] = [
    "Voice",
    "Readability",
    "Completeness",
    "Copy editing",
]
---

<div class={`relative ${className}`}>
    <div
        class="not-prose -rotate-1 rounded-lg border border-gray-200 bg-white p-6 shadow-sm"
    >
        <div class="mb-6 flex items-baseline gap-4">
            <div class="flex items-center gap-1.5">
                <div class="h-2 w-2 rounded-full bg-gray-400"></div>
                <span class="text-[9px] font-medium text-gray-500 uppercase tracking-wide">Document level</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="h-2 w-2 rounded-full bg-orange-400"></div>
                <span class="text-[9px] font-medium text-gray-500 uppercase tracking-wide">Section level</span>
            </div>
        </div>

        <div class="relative">
            <div class="flex flex-col">
                {
                    phases.map((phase, index) => (
                        <div class="relative flex items-stretch">
                            {/* Left column: dot and connector */}
                            <div class="flex flex-col items-center w-8 flex-shrink-0">
                                {/* Top connector */}
                                {index > 0 && (
                                    <div class="w-px flex-1 bg-gray-200" />
                                )}
                                {index === 0 && <div class="flex-1" />}

                                {/* Dot */}
                                <div
                                    class={`h-2.5 w-2.5 rounded-full flex-shrink-0 ${
                                        phase.level === "document"
                                            ? "bg-gray-400"
                                            : "bg-orange-400"
                                    }`}
                                />

                                {/* Bottom connector */}
                                {index < phases.length - 1 && (
                                    <div class="w-px flex-1 bg-gray-200" />
                                )}
                                {index === phases.length - 1 && <div class="flex-1" />}
                            </div>

                            {/* Right column: content */}
                            <div class={`flex-1 min-w-0 pl-3 ${index === 0 ? 'pb-5' : index === phases.length - 1 ? 'pt-5' : 'py-5'}`}>
                                <div class="flex items-baseline justify-between gap-2">
                                    <div class="flex items-baseline gap-2">
                                        <span class="text-sm font-semibold text-gray-800">
                                            {phase.name}
                                        </span>
                                        <span class="text-[10px] text-gray-400">
                                            {phase.description}
                                        </span>
                                    </div>
                                    <span class="font-mono text-[10px] text-gray-300 flex-shrink-0">
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                </div>

                                {/* Review agents expansion */}
                                {phase.name === "Review" && (
                                    <div class="mt-2 flex flex-wrap gap-1.5">
                                        {reviewAgents.map((agent) => (
                                            <span class="rounded border border-gray-200 bg-gray-50 px-2 py-0.5 text-[9px] font-medium text-gray-600">
                                                {agent}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</div>
