---
export interface Props {
    className?: string
}

type Trend = "up" | "down"

interface Metric {
    readonly title: string
    readonly value: string
    readonly subtitle: string
    readonly trend: Trend
}

const { className = "" } = Astro.props

const metrics: readonly Metric[] = [
    {
        title: "Component Usage",
        value: "1,247",
        subtitle: "Total instances",
        trend: "up",
    },
    {
        title: "Library Adoption",
        value: "89%",
        subtitle: "Teams using libraries",
        trend: "up",
    },
    {
        title: "Detachment Rate",
        value: "12%",
        subtitle: "Components modified",
        trend: "down",
    },
    {
        title: "Usage Frequency",
        value: "3.2x",
        subtitle: "Avg per project",
        trend: "up",
    },
]

const chartData: readonly (readonly number[])[] = [
    [5, 8, 6, 12, 15, 18],
    [10, 15, 20, 25, 30, 35],
    [20, 18, 15, 12, 10, 8],
    [2, 3, 2.5, 3.2, 3.8, 4.1],
]

const generateMiniChartPath = (index: number): string => {
    const points = chartData[index]

    const pathData = points
        .map((point, i) => {
            const x = 10 + (i / (points.length - 1)) * 80
            const maxValue = Math.max(...points)
            const y = 80 - (point / maxValue) * 60
            return `${i === 0 ? "M" : "L"} ${x} ${y}`
        })
        .join(" ")

    return pathData
}
---

<div
    class={`not-prose min-w-[24rem] -rotate-2 rounded-lg border border-gray-200 bg-white p-4 shadow-sm ${className}`}
>
    <div class="grid grid-cols-2 gap-4">
        {
            metrics.map((metric, index) => (
                <div class="overflow-hidden rounded-lg border border-gray-100 bg-gray-50">
                    <div class="grid h-full grid-cols-2">
                        <div class="flex flex-col justify-center space-y-2 p-4">
                            <span class="text-[10px] leading-relaxed font-medium tracking-wide text-gray-600 uppercase">
                                {metric.title}
                            </span>
                            <div class="text-xl leading-normal font-bold text-gray-900">
                                {metric.value}
                            </div>
                            <div class="h-2 w-16 rounded bg-gray-200" />
                        </div>

                        <div class="relative">
                            <svg
                                width="100%"
                                height="100%"
                                class="absolute inset-0"
                            >
                                <defs>
                                    <pattern
                                        id={`fullgrid-${index}`}
                                        width="12"
                                        height="12"
                                        patternUnits="userSpaceOnUse"
                                    >
                                        <path
                                            d="M 12 0 L 0 0 0 12"
                                            fill="none"
                                            stroke="#e5e7eb"
                                            stroke-width="0.5"
                                        />
                                    </pattern>
                                    <linearGradient
                                        id={`fade-${index}`}
                                        x1="0%"
                                        y1="0%"
                                        x2="100%"
                                        y2="0%"
                                    >
                                        <stop
                                            offset="0%"
                                            stop-color="white"
                                            stop-opacity="0.8"
                                        />
                                        <stop
                                            offset="15%"
                                            stop-color="white"
                                            stop-opacity="0.2"
                                        />
                                        <stop
                                            offset="85%"
                                            stop-color="white"
                                            stop-opacity="0.2"
                                        />
                                        <stop
                                            offset="100%"
                                            stop-color="white"
                                            stop-opacity="0.8"
                                        />
                                    </linearGradient>
                                    <linearGradient
                                        id={`fadey-${index}`}
                                        x1="0%"
                                        y1="0%"
                                        x2="0%"
                                        y2="100%"
                                    >
                                        <stop
                                            offset="0%"
                                            stop-color="white"
                                            stop-opacity="0.8"
                                        />
                                        <stop
                                            offset="15%"
                                            stop-color="white"
                                            stop-opacity="0.2"
                                        />
                                        <stop
                                            offset="85%"
                                            stop-color="white"
                                            stop-opacity="0.2"
                                        />
                                        <stop
                                            offset="100%"
                                            stop-color="white"
                                            stop-opacity="0.8"
                                        />
                                    </linearGradient>
                                </defs>
                                <rect
                                    width="100%"
                                    height="100%"
                                    fill={`url(#fullgrid-${index})`}
                                />
                                <rect
                                    width="100%"
                                    height="100%"
                                    fill={`url(#fade-${index})`}
                                />
                                <rect
                                    width="100%"
                                    height="100%"
                                    fill={`url(#fadey-${index})`}
                                />
                            </svg>

                            <div class="absolute inset-0">
                                <svg
                                    width="100%"
                                    height="100%"
                                    viewBox="0 0 100 100"
                                >
                                    <path
                                        d={generateMiniChartPath(index)}
                                        fill="none"
                                        stroke={
                                            metric.trend === "up"
                                                ? "#10b981"
                                                : "#ef4444"
                                        }
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</div>
