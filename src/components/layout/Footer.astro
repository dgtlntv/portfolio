---
import Envelope from "astro-heroicons/solid/Envelope.astro"

export interface Props {
    slim?: boolean
}

const { slim = false } = Astro.props

const currentYear = new Date().getFullYear()

const socialLinks = [
    {
        name: "Linkedin",
        url: "https://www.linkedin.com/in/maxblazek/",
        icon: "linkedin",
    },
    {
        name: "Mail",
        url: "mailto:mail@mblazek.xyz",
        icon: "mail",
    },
]

const containerClasses = slim
    ? "flex items-center justify-between py-2 md:py-4"
    : "py-12 md:flex md:items-center md:justify-between"

const socialClasses = `flex justify-center space-x-4 ${slim ? "order-2" : "md:order-2"}`
const textClasses = slim ? "order-1" : "mt-8 md:order-1 md:mt-0"
---

<footer id="footer" class="bg-white" transition:persist="site-footer">
    <div class={containerClasses}>
        <div class={socialClasses}>
            {
                socialLinks.map((link) => (
                    <a
                        href={link.url}
                        class={
                            link.icon === "linkedin"
                                ? "flex flex-col justify-center text-gray-400 hover:text-gray-500"
                                : "text-gray-400 hover:text-gray-500"
                        }
                    >
                        <span class="sr-only">{link.name}</span>
                        {link.icon === "linkedin" ? (
                            <svg
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                class="h-5 w-5"
                                aria-hidden="true"
                            >
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                            </svg>
                        ) : (
                            <Envelope class="h-6 w-6" aria-hidden="true" />
                        )}
                    </a>
                ))
            }
        </div>
        <div class={textClasses}>
            <p class="font-fancy text-center text-base text-gray-400">
                {currentYear} Maximilian Blazek
            </p>
        </div>
    </div>
</footer>
