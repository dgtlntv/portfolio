---
import Bars3 from "astro-heroicons/outline/Bars3.astro"
import XMark from "astro-heroicons/outline/XMark.astro"
import { NAVIGATION_LINKS } from "../../../data/navigation"
import ContactButton from "./ContactButton.astro"
import Logo from "./Logo.astro"
import NavigationItem from "./NavigationItem.astro"

const currentPath = Astro.url.pathname
---

<div class="-my-2 -mr-2 md:hidden">
    <button
        id="mobile-menu-trigger"
        class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-black"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-dialog"
    >
        <Bars3 class="h-6 w-6" aria-hidden="true" />
    </button>
</div>

<mobile-menu-dialog id="mobile-menu-dialog" class="md:hidden">
    <div class="px-4 py-5 sm:px-6">
        <div class="flex items-center justify-between">
            <Logo />
            <div>
                <button
                    id="mobile-menu-close"
                    class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-black"
                    aria-label="Close navigation menu"
                >
                    <XMark class="h-6 w-6" aria-hidden="true" />
                </button>
            </div>
        </div>
    </div>
    <nav class="px-4 py-6 sm:px-6" aria-label="Mobile navigation">
        <div class="grid grid-cols-1 gap-4">
            {
                NAVIGATION_LINKS.map((link) => (
                    <NavigationItem
                        to={link.to}
                        label={link.label}
                        isExternal={link.isExternal}
                        variant="mobile"
                        currentPath={currentPath}
                    />
                ))
            }
            <ContactButton />
        </div>
    </nav>
</mobile-menu-dialog>

<script>
    interface MobileMenuDialogElement extends HTMLElement {
        open(): void
        close(): void
    }

    function initializeMobileMenu(): void {
        const menuTrigger = document.getElementById("mobile-menu-trigger")
        const menuDialog = document.getElementById(
            "mobile-menu-dialog",
        ) as MobileMenuDialogElement | null

        if (!menuTrigger || !menuDialog) return

        menuTrigger.addEventListener("click", () => {
            menuDialog.open()
            menuTrigger.setAttribute("aria-expanded", "true")
        })

        menuDialog.addEventListener("mobile-menu-closed", () => {
            menuTrigger.setAttribute("aria-expanded", "false")
            menuTrigger.focus()
        })

        menuDialog.addEventListener("mobile-menu-opened", () => {
            menuTrigger.setAttribute("aria-expanded", "true")
        })
    }

    initializeMobileMenu()

    document.addEventListener("astro:page-load", initializeMobileMenu)
</script>
