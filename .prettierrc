{
    "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-astro"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ],
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "proseWrap": "always"
}
